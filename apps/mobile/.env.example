# Copy to .env (git-ignored) for local dev. All EXPO_PUBLIC_* values ship inside the APK — public by design.
EXPO_PUBLIC_SUPABASE_URL=https://xatbfyiytcnogfbtfsym.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_QpEcKrru1S6jW-k6llv30Q_4mV1QXO7
# Google Cloud → Credentials → OAuth client of type *Web application* (same one Supabase Google provider uses)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Python backend (Render) — e.g. https://paisa-kidhar-api.onrender.com
EXPO_PUBLIC_API_URL=
# AdMob ad unit IDs (dev builds always use Google test IDs)
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# Build-time only (not EXPO_PUBLIC): AdMob *App* ID
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
